# VITE_GA4_MEASUREMENT_ID: Google Analytics 4 Measurement ID.
# Get from: https://analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# VITE_GOOGLE_SITE_VERIFICATION: Google Search Console HTML tag verification.
# Get from: Search Console → Settings → Ownership Verification → HTML tag
# Paste only the content="..." value.
VITE_GOOGLE_SITE_VERIFICATION=